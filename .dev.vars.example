# Copy to .dev.vars (gitignored) for local development.
# .dev.vars is read by wrangler AND by the local Vite Pages-Functions adapter.

# Leave empty while MOCK_GEMINI=true. Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# minimal (default) or auto. Minimal keeps a whole-document analysis inside its deadline.
GEMINI_THINKING=minimal

# Any random string >= 32 bytes. Generate: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=local-development-session-secret-change-me
IP_HASH_SALT=local-development-ip-salt-change-me

# true = no network calls, fixture responses from functions/lib/mock. Keep true unless testing the real API.
MOCK_GEMINI=true

ALLOWED_ORIGIN=http://localhost:5173
