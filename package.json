{
  "name": "signsure",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Understand every clause before you sign - AI explanations of Indian offer letters with code-verified citations.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev --port 8788",
    "preview:full": "npm run build && wrangler pages dev dist --port 8788",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.functions.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "eval": "tsx --tsconfig tsconfig.node.json scripts/eval.ts",
    "size": "node scripts/bundle-size.mjs",
    "secretscan": "node scripts/secret-scan.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name signsure",
    "deploy:preview": "npm run build && wrangler pages deploy dist --project-name signsure --branch preview"
  },
  "dependencies": {
    "@google/genai": "2.23.0",
    "clsx": "2.1.1",
    "mammoth": "1.12.3",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20260920.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "vitest-axe": "0.1.0",
    "wrangler": "4.135.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
